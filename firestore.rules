rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // GLOBAL HELPERS
    // ----------------------------------------------------
    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data;
    }

    function isSuperAdmin() {
      return request.auth != null && (
               request.auth.token.email == 'juualleixo@gmail.com' ||
               request.auth.token.email == 'lapallyra@gmail.com'
             );
    }

    function isAdmin() { 
      return isSuperAdmin() || (
        request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)) &&
        getUserData().active == true &&
        getUserData().role == 'ADMINISTRADOR'
      );
    }
    
    function isStaff() {
      return isSuperAdmin() || (
        request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)) &&
        getUserData().active == true
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    match /admin_users/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // SYSTEM NOTIFICATIONS
    // ----------------------------------------------------
    match /system_notifications/{configId} {
      allow read, write: if isStaff();
    }

    match /telegram_logs/{logId} {
      allow create: if true;
      allow get, list, update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // PRODUCTS
    // ----------------------------------------------------
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['company', 'product_name', 'retail_price']) &&
               data.company in ['pallyra', 'guennita', 'mimada'] &&
               data.product_name is string && data.product_name.size() > 0 && data.product_name.size() <= 200 &&
               data.retail_price is number && data.retail_price >= 0;
      }
      
      allow get, list: if true;
      allow create: if isStaff() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isStaff() && isValidProduct(incoming());
      allow delete: if isStaff();
    }

    // ----------------------------------------------------
    // ORDERS
    // ----------------------------------------------------
    match /orders/{orderId} {
      // Criar pedido público (checkout)
      allow create: if true;
      
      // Detalhes individuais: apenas admin (Proteção LGPD)
      allow get: if isStaff();

      // Consulta de rastreio: permitida apenas se filtrar por código
      // Isso impede listagem total por usuários públicos
      allow list: if isStaff() || (
        request.query.filters != null &&
        "code" in request.query.filters
      );

      // Atualização pós-venda: apenas campos não sensíveis
      // Removemos 'status' e 'batchId' da permissão pública
      allow update: if isStaff() || 
        incoming().diff(existing()).affectedKeys().hasOnly([
          "roulettePrize",
          "roulettePlayed",
          "giftInfo",
          "whatsappSent",
          "thankYouShown",
          "updatedAt"
        ]);

      // Somente admin pode deletar
      allow delete: if isStaff();

      // Histórico de Versões do Pedido
      match /versions/{versionId} {
        allow read, write: if isStaff();
      }
    }

    // ----------------------------------------------------
    // CUSTOMERS
    // ----------------------------------------------------
    match /customers/{customerId} {
      allow get, list: if isStaff();
      allow create: if true; 
      allow update: if isStaff() || (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'totalSpent', 'ordersCount', 'name', 'cpfCnpj', 'email', 
          'address', 'city', 'state', 'zipCode', 'number', 'neighborhood'
        ])
      );
      allow delete: if isStaff();
    }

    // ----------------------------------------------------
    // SETTINGS / CONFIG
    // ----------------------------------------------------
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    match /appConfig/{configId} {
      allow get, list: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // SUGGESTIONS
    // ----------------------------------------------------
    match /suggestions/{suggestionId} {
      allow create: if incoming().keys().hasAll(['companyId', 'message', 'createdAt', 'read']) &&
                     incoming().message is string && incoming().message.size() <= 2000 &&
                     incoming().createdAt == request.time && incoming().read == false;
      allow get, list, update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // FEEDBACKS
    // ----------------------------------------------------
    match /checkout_funnel_logs/{logId} {
      allow create: if true;
      allow get, list, update, delete: if isStaff();
    }

    match /feedbacks/{feedbackId} {
      allow create: if incoming().keys().hasAll(['name', 'text', 'stars', 'createdAt']) &&
                     incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200 &&
                     incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000 &&
                     incoming().stars is number && incoming().stars >= 1 && incoming().stars <= 5;
      allow get, list: if true;
      allow update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // INVENTORY (INSUMOS)
    // ----------------------------------------------------
    match /insumos/{insumoId} {
      allow get: if true; // Needed to check stock before taking
      allow list: if isStaff();
      allow update: if isStaff() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['totalQuantity']) &&
        incoming().totalQuantity < existing().totalQuantity
      );
      allow create, delete: if isStaff();
    }

    match /insumo_movements/{movementId} {
      allow create: if true;
      allow get, list, update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // FINANCE
    // ----------------------------------------------------
    match /finance/{entryId} {
      allow create: if true; // Allow sale revenue recording
      allow get, list, update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // MONTHLY PROFIT HISTORY
    // ----------------------------------------------------
    match /monthly_profit_history/{entryId} {
      allow get, list, create, update, delete: if isStaff();
    }

    // ----------------------------------------------------
    // GIFT LISTS 
    // ----------------------------------------------------
    match /giftLists/{listId} {
      allow get, list, create: if true;
      allow update: if true; // Needed for item status updates by customers
      allow delete: if isStaff();
    }

    // ----------------------------------------------------
    // ADDONS
    // ----------------------------------------------------
    match /addons/{addonId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // COMMEMORATIVE DATES
    // ----------------------------------------------------
    match /datas_comemorativas/{dateId} {
      function isValidCommemorativeDate(data) {
        return data.keys().hasAll(['name', 'category', 'active', 'day', 'month']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.category is string &&
               data.active is bool &&
               data.day is number && data.day >= 0 && data.day <= 31 &&
               data.month is number && data.month >= 0 && data.month <= 12;
      }

      allow list, get: if true;
      allow create: if isStaff() && isValidId(dateId) && isValidCommemorativeDate(incoming());
      allow update: if isStaff() && isValidCommemorativeDate(incoming());
      allow delete: if isStaff();
    }

    // ----------------------------------------------------
    // REVIEWS
    // ----------------------------------------------------
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'createdAt']) &&
               data.productId is string && data.productId.size() <= 128 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.userName is string && data.userName.size() <= 128 &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.createdAt == request.time &&
               (data.comment is string && data.comment.size() <= 1000) &&
               (data.adminReply == null || data.adminReply is string && data.adminReply.size() <= 1000);
      }

      allow list, get: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['adminReply', 'updatedAt']);
      allow delete: if isStaff();
    }

    // ----------------------------------------------------
    // PRIZES
    // ----------------------------------------------------
    match /prizes/{prizeId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // PRODUCT COLLECTIONS
    // ----------------------------------------------------
    match /product_collections/{collectionId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // PRODUCT CAMPAIGNS
    // ----------------------------------------------------
    match /product_campaigns/{campaignId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // CAMPAIGNS
    // ----------------------------------------------------
    match /campaigns/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // MEDIA CENTER (FOLDERS & FILES)
    // ----------------------------------------------------
    match /media_folders/{folderId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    match /media_files/{fileId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // COUPONS
    // ----------------------------------------------------
    match /coupons/{couponId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // CHECKLIST & EVENTS
    // ----------------------------------------------------
    match /checklist/{itemId} {
      allow read, write: if isStaff();
    }

    match /events/{eventId} {
      allow read, write: if isStaff();
    }

    // ----------------------------------------------------
    // AUDIT LOGS
    // ----------------------------------------------------
    match /audit_logs/{logId} {
      allow read, write: if isStaff();
    }

    // ----------------------------------------------------
    // MANUFACTURING & SUPPLIES (ADMIN ONLY)
    // ----------------------------------------------------
    match /componentes/{componentId} {
      allow read, write: if isStaff();
    }

    match /purchase_orders/{purchaseId} {
      allow read, write: if isStaff();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isStaff();
    }

    match /componente_movements/{movementId} {
      allow read, write: if isStaff();
    }

    match /productionBatches/{batchId} {
      allow read, write: if isStaff();
    }

    // ----------------------------------------------------
    // PROMOTIONAL CAMPAIGNS
    // ----------------------------------------------------
    match /promotional_campaigns/{campaignId} {
      allow list, get: if true;
      allow write: if isStaff();
    }

    // ----------------------------------------------------
    // DEFAULT DENY (LAST RESORT)
    // ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
